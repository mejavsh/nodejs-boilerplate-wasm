{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "nodenext",
    "target": "es2022",
    "jsx": "react",
    "skipLibCheck": true,
    "lib": ["ES2022", "WebWorker"],
    "allowJs": true,
    "strict": true,
    "noImplicitReturns": true,
