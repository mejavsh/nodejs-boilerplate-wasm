{
  "name": "next-boilerplate",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs && mkdirp dist && j2w -i build/bundle.js --initLocation http://next-boilerplate.localhost -o dist/next-boilerplate.wasm",
    "build:debug": "node build.mjs && mkdirp dist && j2w -d -i build/bundle.js --initLocation http://next-boilerplate.localhost -o dist/next-boilerplate.wasm",
    "build:vinext": "vinext build",
    "dev:vinext": "vinext dev --port 3001",
    "start:vinext": "vinext start",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "db:pg:start": "docker compose up -d --wait postgres",
    "db:pg:stop": "docker compose down",
    "db:migrate:pg": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spin_counter drizzle-kit migrate",
    "test:e2e:spin": "run-s db:pg:start db:migrate:pg test:e2e:spin:run",
    "test:e2e:spin:run": "playwright test --config playwright.spin.config.ts"
  },
  "dependencies": {
    "@arcjet/next": "^1.4.0",
    "@clerk/localizations": "^4.5.5",
    "@clerk/nextjs": "^7.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@logtape/logtape": "^2.0.5",
    "@sentry/nextjs": "^10.50.0",
    "@spinframework/build-tools": "^1.0.4",
    "@spinframework/spin-postgres": "^2.0.0",
    "@spinframework/wasi-http-proxy": "^1.0.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.4",
    "next-intl": "^4.10.1",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "vinext": "^0.2.1",
    "vite": "^8.0.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^0.15.0",
    "@commitlint/cli": "^20.5.2",
